# /etc/systemd/system/jogo.service, installed by ops/setup.sh. The site and game server (server/, M2+).
# ops/jogo-deploy installs each commit into /srv/jogo/venvs/<sha>, points venvs/current at it and restarts this
# (its only sudo rule). The app refuses to start unless this CPU simulates like the browser (golden.txt).
[Unit]
Description=Jogo de Carro (site e servidor)
After=network.target

[Service]
User=jogo
Group=jogo
EnvironmentFile=/etc/jogo/env
Environment=PYTHONDONTWRITEBYTECODE=1
# one worker: rooms, presence and rate limits live in this process's memory
ExecStart=/srv/jogo/venvs/current/bin/uvicorn jogo_server.app:app --host 127.0.0.1 --port 8090 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --ws-max-size 16384 --no-access-log
Restart=always
# a refused start (golden mismatch) costs about 3 s of CPU: retry calmly
RestartSec=5
MemoryMax=1G
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/jogo
CapabilityBoundingSet=
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK: glibc's getaddrinfo may ask the kernel which address families are configured
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
