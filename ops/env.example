# Configuração do jogo.service: /etc/jogo/env (root:jogo, 0640). O ops/setup.sh cria o arquivo a partir deste
# modelo, com um SESSION_SECRET aleatório, e nunca mexe num que já exista: uma chave nova daqui que falte nele
# vale o padrão do servidor (o valor abaixo); acrescente-a à mão para mudar. Depois de editar (derruba as corridas
# ao vivo; o próximo deploy aplica a mudança drenando antes):
#   systemctl restart jogo.service
# Guarde uma cópia no seu gerenciador de senhas. Formato do systemd: CHAVE=valor, uma por linha, sem aspas;
# comentários só em linha própria.

# Domínio público: os links dos e-mails e o retorno do Google são montados a partir dele, nunca do pedido.
DOMAIN=jogo.pericles.dev.br

# Segredo dos cookies de estado do login com Google (gerado pelo setup.sh; trocar desconecta logins em curso).
SESSION_SECRET=

# Login com Google: vazio esconde "Entrar com Google". Cliente OAuth "Aplicativo da Web" com o URI de
# redirecionamento https://jogo.pericles.dev.br/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de e-mail (cadastro, senha esquecida, troca de senha) por um relay SMTP na porta 587 com STARTTLS
# (por exemplo Brevo). Com SMTP_HOST vazio o cadastro mostra "e-mail indisponível".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente: Jogo de Carro <nao-responda@pericles.dev.br> (o domínio autenticado no Brevo, com DKIM)
MAIL_FROM=
# O e-mail de contato mostrado em /privacidade.
ADMIN_EMAIL=

# Banco de dados (SQLite) e a pasta publicada pelo jogo-deploy.
JOGO_DB=/var/lib/jogo/jogo.db
JOGO_WWW=/srv/jogo/www

# Corridas ranqueadas (M3). Quantas corridas ao vivo o servidor aceita ao mesmo tempo; além disso o jogo mostra
# "Servidor cheio". Meça neste VPS com jogo-admin load --n 100 (README, "M3") e ajuste.
MAX_ATIVAS=100
# Detector de bot (plano §6.7) para as corridas fora do top 10 (as que entrariam no top 10 sempre vão para
# revisão). Vai para revisão a corrida com pelo menos FLAG_MIN_N reações medidas (de uma mudança do corredor
# livre até a virada que a segue) cujo p10 fica abaixo de FLAG_P10 ou cuja mediana fica abaixo de FLAG_MEDIAN
# (em ticks de 1/120 s), ou que segue o corredor livre em FLAG_ADHERENCE das fileiras ou mais.
FLAG_MIN_N=30
FLAG_P10=7
FLAG_MEDIAN=12
FLAG_ADHERENCE=0.99
